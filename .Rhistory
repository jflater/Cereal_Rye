all_points_adjusted <- all_points %>%
mutate(
UTM_x = x + utm_origin_easting,
UTM_y = y + utm_origin_northing
)
# Convert to an sf object with the UTM CRS (adjust EPSG code as needed)
all_points_sf <- st_as_sf(all_points_adjusted, coords = c("UTM_x", "UTM_y"), crs = 32615)
# Transform to WGS84 (EPSG:4326) if your GPS expects latitude/longitude
all_points_sf_wgs84 <- st_transform(all_points_sf, crs = 4326)
mapview(all_points_sf_wgs84)
# Export the shapefile (this creates the .shp, .shx, .dbf, and .prj files)
st_write(all_points_sf_wgs84, "field_work_points.shp", append = F)
# -------------------------------
# Step 1: Create the outer grid (8 x 8, 25 m apart)
# -------------------------------
# x- and y-coordinates: 8 points from 0 to 25*(8-1) = 175 m
outer_grid <- expand.grid(x = seq(0, (8 - 1) * 25, by = 25),
y = seq(0, (8 - 1) * 25, by = 25))
# -------------------------------
# Step 2: Create the middle grid (5 x 5, 5 m apart)
# -------------------------------
# We will nest this grid at the center of the outer grid.
outer_x_range <- range(outer_grid$x)
outer_y_range <- range(outer_grid$y)
middle_center_x <- mean(outer_x_range)
middle_center_y <- mean(outer_y_range)
# For a 5-point grid with spacing 5, the total span is (5-1)*5 = 20 meters.
# Determine the bottom left of the middle grid so it is centered.
middle_offset <- (5 - 1) * 5 / 2  # equals 10 m
middle_x0 <- middle_center_x - middle_offset
middle_y0 <- middle_center_y - middle_offset
middle_grid <- expand.grid(x = seq(middle_x0, by = 5, length.out = 5),
y = seq(middle_y0, by = 5, length.out = 5))
# -------------------------------
# Step 3: Create the inner grid (5 x 5, 0.5 m apart)
# -------------------------------
# We nest this grid at the center of the middle grid.
middle_x_range <- range(middle_grid$x)
middle_y_range <- range(middle_grid$y)
inner_center_x <- mean(middle_x_range)
inner_center_y <- mean(middle_y_range)
# For a 5-point grid with spacing 0.5, the total span is (5-1)*0.5 = 2 m.
inner_offset <- (5 - 1) * 0.5 / 2  # equals 1 m
inner_x0 <- inner_center_x - inner_offset
inner_y0 <- inner_center_y - inner_offset
inner_grid <- expand.grid(x = seq(inner_x0, by = 0.5, length.out = 5),
y = seq(inner_y0, by = 0.5, length.out = 5))
# -------------------------------
# Step 4: Plot the grids for visual verification
# -------------------------------
plot(outer_grid$x, outer_grid$y,
pch = 16, col = "blue",
xlab = "X (m)", ylab = "Y (m)",
xlim = c(min(outer_grid$x) - 10, max(outer_grid$x) + 10),
ylim = c(min(outer_grid$y) - 10, max(outer_grid$y) + 10),
main = "Nested Grid Layout for Field Work")
points(middle_grid$x, middle_grid$y, pch = 16, col = "red")
points(inner_grid$x, inner_grid$y, pch = 16, col = "green")
legend("topright", legend = c("Outer Grid (25 m)", "Middle Grid (5 m)", "Inner Grid (0.5 m)"),
col = c("blue", "red", "green"), pch = 16)
# -------------------------------
# Step 5: Make a shapefile with GPS coordinates
# -------------------------------
library(dplyr)
library(sf)
library(mapview)
# Label each grid for reference.
outer_grid <- outer_grid %>% mutate(Grid = "Outer")
middle_grid <- middle_grid %>% mutate(Grid = "Middle")
inner_grid <- inner_grid %>% mutate(Grid = "Inner")
# Combine all the grids into a single data frame.
all_points <- bind_rows(outer_grid, middle_grid, inner_grid)
# Create an sf object from the local grid points.
# Note: At this point the coordinates (x, y) are relative local coordinates.
all_points_sf_local <- st_as_sf(all_points, coords = c("x", "y"), crs = 32633)  # Temporary CRS
# Define the origin based on a known location.
# Create an sf object for the origin using WGS84 (latitude/longitude)
origin <- st_sfc(st_point(c(-93.7077880, 41.9977157)), crs = 4326)
# Transform the origin to UTM Zone 15N (EPSG:32615) used for Ames, Iowa.
origin_utm <- st_transform(origin, crs = 32615)
origin_coords <- st_coordinates(origin_utm)
print(origin_coords)
# For example, you might get:   X = 441422.1   and   Y = 4649880
# Set your UTM origin values based on the computed coordinates.
utm_origin_easting  <- origin_coords[1,1]
utm_origin_northing <- origin_coords[1,2]
# Adjust the local grid points by adding the UTM origin offsets.
all_points_adjusted <- all_points %>%
mutate(
UTM_x = x + utm_origin_easting,
UTM_y = y + utm_origin_northing
)
# Convert the adjusted points to an sf object in UTM Zone 15N (EPSG:32615).
all_points_sf <- st_as_sf(all_points_adjusted, coords = c("UTM_x", "UTM_y"), crs = 32615)
# Transform to WGS84 (EPSG:4326) for GPS compatibility.
all_points_sf_wgs84 <- st_transform(all_points_sf, crs = 4326)
# Visualize the points with mapview.
mapview(all_points_sf_wgs84)
# Export as a shapefile.
st_write(all_points_sf_wgs84, "field_work_points.shp", delete_dsn = TRUE)
